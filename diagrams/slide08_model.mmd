    PCT["백분위 환산<br/>0~100"]:::proc
    TBRI(["TBRI 점수"]):::proc

    G1["🟩 녹색<br/>0~50<br/>양호"]:::green
    G2["🟧 황색<br/>50~75<br/>주의"]:::yellow
    G3["🟥 적색<br/>75~100<br/>위험"]:::red

